# Copy to .env for local testing. In production these live as GitHub Actions
# repository secrets (Settings -> Secrets and variables -> Actions), never committed.

# --- Content generation ---
ANTHROPIC_API_KEY=

# --- Voiceover ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Carousel background photos (Pexels, free) ---
# Get a free key at pexels.com/api. Optional: without it, carousel slides
# fall back to the flat clinical background (no error).
PEXELS_API_KEY=

# --- Instagram Graph API ---
# IG_USER_ID: the Instagram Business/Creator account's numeric user id
# IG_ACCESS_TOKEN: a long-lived Page access token with instagram_basic +
#   instagram_content_publish permissions (see README "Instagram setup")
IG_USER_ID=
IG_ACCESS_TOKEN=

# --- Asset storage (Cloudflare R2, S3-compatible) ---
# The Graph API needs a public URL to fetch rendered video/images from,
# so rendered files are uploaded here before publishing.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# --- Scheduling ---
# IANA timezone the editorial calendar's posting times (7:00 / 20:30) are in.
TIMEZONE=America/New_York

# --- Safety ---
# When true, the pipeline generates and renders content but skips the actual
# Instagram publish call and R2 upload — useful for testing end to end.
DRY_RUN=false
